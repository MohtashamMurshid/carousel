{
  "name": "carousel",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Client-only Instagram and LinkedIn carousel composer. Filmstrip preview, URL-as-state, local PNG export.",
  "author": "Mohtasham Madani",
  "license": "MIT",
  "keywords": [
    "carousel",
    "instagram",
    "filmstrip",
    "vite",
    "react"
